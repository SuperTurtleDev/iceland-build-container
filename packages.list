# Packages installed into the sm8850 kernel build container.
#
# provision.sh installs these in one apt-get run; if the versioned toolchain
# packages (the -21 suffixes) are not in the archive it retries with the
# version suffix stripped (clang-21 -> clang, lld-21 -> lld, llvm-21 -> llvm)
# and records the real choice in /opt/build-env.txt (CONTAINER_DATA/build-env.txt).
#
# Toolchain (kernel is built with ARCH=arm64 LLVM=1, clang-21 matches
# CONFIG_CC_VERSION_TEXT)
clang-21
lld-21
llvm-21
# Kernel build dependencies
bc
bison
flex
libssl-dev
libelf-dev
python3
python3-dev
cpio
zstd
xz-utils
rsync
make
gcc
g++
uuid-dev
git
file
kmod
dwarves
# g++, uuid-dev: also required by the bootloader (edk2 BaseTools: VfrCompile
# links with g++, DevicePath with -luuid from uuid-dev)
# dosfstools, mtools, android-sdk-libsparse-utils: bootloader ESP image
# (FAT32 mkfs.vfat/mcopy, img2simg Android sparse conversion)
dosfstools
mtools
android-sdk-libsparse-utils
# net-deploy: cross toolchain for the static ARM64 deploy server
gcc-aarch64-linux-gnu
libc6-dev-arm64-cross
# kernel: module signing key generation (certs/signing_key.pem)
openssl
